# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Deployer account private key. Needs a little ETH on the target chain for gas.
# This key only deploys; it is NOT the backend signer and holds no app funds.
DEPLOYER_PRIVATE_KEY=0x...

# Backend EIP-712 signer address (the account whose key signs score attestations).
# This address holds NO funds and is only stored on-chain as the trusted signer.
SIGNER_ADDRESS=0x...

# RPC endpoints
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Etherscan v2 API key for contract verification. ONE key works across all
# chains including Base + Base Sepolia (https://etherscan.io/myapikey).
ETHERSCAN_API_KEY=
