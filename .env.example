# Coinbase Developer Platform Client API Key (free, portal.cdp.coinbase.com)
NEXT_PUBLIC_ONCHAINKIT_API_KEY=""

# Public base URL of the deployment (used by the manifest). Empty -> localhost:3000
NEXT_PUBLIC_URL=""

# Base Builder owner address (for the mini-app manifest baseBuilder field)
NEXT_PUBLIC_BUILDER_ADDRESS=""

# Farcaster account association (signed manifest). Produced by:
#   npx create-onchain --manifest
# Left empty until the Farcaster account is signed at deploy time.
FARCASTER_HEADER=""
FARCASTER_PAYLOAD=""
FARCASTER_SIGNATURE=""
