# Coinbase Developer Platform Client API Key (free, portal.cdp.coinbase.com)
NEXT_PUBLIC_ONCHAINKIT_API_KEY=""

# Public base URL of the deployment (used by the manifest). Empty -> localhost:3000
NEXT_PUBLIC_URL=""

# Base Builder owner address (for the mini-app manifest baseBuilder field)
NEXT_PUBLIC_BUILDER_ADDRESS=""

# Farcaster account association (signed manifest). Produced by:
#   npx create-onchain --manifest
# Left empty until the Farcaster account is signed at deploy time.
FARCASTER_HEADER=""
FARCASTER_PAYLOAD=""
FARCASTER_SIGNATURE=""

# Backend signer private key for the EIP-712 score attestation (mint/refresh).
# SERVER-ONLY — never prefix with NEXT_PUBLIC. The signer holds no funds and only
# signs scores. With or without a leading 0x. Empty -> /api/sign-score returns 503.
SIGNER_PRIVATE_KEY=""

# Target chain for signing + minting. Keep signer and Mint button in lockstep.
#   84532 = Base Sepolia (deploy here first)   8453 = Base mainnet
# Absent/unparseable -> defaults to 8453 (mainnet).
NEXT_PUBLIC_CHAIN_ID="8453"

# Deployed DropRank badge contract address (on NEXT_PUBLIC_CHAIN_ID's network).
# Placeholder 0x000...0 until deployed; the Mint button stays disabled ("BADGE SOON")
# and /api/sign-score refuses to sign (503).
NEXT_PUBLIC_BADGE_CONTRACT=""

# Upstash Redis (percentile sorted-set + score cache). Free tier at upstash.com.
# Absent or unreachable -> percentile falls back to the static embedded curve.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
